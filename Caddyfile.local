http://127.0.0.1:8080 {
	bind 127.0.0.1
	@reader {
		method GET
		path_regexp reader ^/api/v1/reader/(session|preferences|threads|threads/[^/]+/(settings|transcript\.txt|messages/page|coach-turn|project|bookmarks|uploads|sources(/[^/]+(/content)?)?|messages/[^/]+/citations/[^/]+/content))$
	}
	handle @reader {
		reverse_proxy 127.0.0.1:8000
	}
	@lecture {
		method POST
		path_regexp lecture ^/api/v1/reader/(preferences|threads|threads/[^/]+/(settings|remove|move|attachments|coach-turn/stop|messages/[^/]+/(revise(/stream)?|learning-signal|star)|uploads(/[^/]+/(retry|discard))?|sources/[^/]+/(select|remove|link)|lecture/stream|project/(brief|stream|select-stage|resolve/[^/]+)))$
	}
	handle @lecture {
		reverse_proxy 127.0.0.1:8000 {
			flush_interval -1
		}
	}
	handle /pilot {
		redir /pilot/ 308
	}
	handle /pilot/* {
		reverse_proxy 127.0.0.1:8000
	}
	# Local browser auth routes are exact-match only. The rest of FastAPI is not
	# reachable through this browser-facing proxy.
	handle /api/v1/auth/guest/start {
		reverse_proxy 127.0.0.1:8000
	}
	handle /api/v1/auth/guest/probe {
		reverse_proxy 127.0.0.1:8000
	}
	handle /api/v1/auth/guest/renew {
		reverse_proxy 127.0.0.1:8000
	}
	handle /api/v1/auth/guest/claim/preview {
		reverse_proxy 127.0.0.1:8000
	}
	handle /api/v1/auth/guest/claim/confirm {
		reverse_proxy 127.0.0.1:8000
	}
	handle /api/v1/auth/guest/claim/cancel {
		reverse_proxy 127.0.0.1:8000
	}
	handle /api/v1/auth/login {
		reverse_proxy 127.0.0.1:8000
	}
	handle /api/v1/auth/callback {
		reverse_proxy 127.0.0.1:8000
	}
	handle /api/v1/auth/me {
		reverse_proxy 127.0.0.1:8000
	}
	handle /api/v1/auth/refresh {
		reverse_proxy 127.0.0.1:8000
	}
	handle /api/v1/auth/logout {
		reverse_proxy 127.0.0.1:8000
	}
	handle /api/v1/health {
		reverse_proxy 127.0.0.1:8000
	}
	handle /api/* {
		respond "Not Found" 404
	}
	handle / {
		reverse_proxy 127.0.0.1:8000
	}

	@streamlit path /streamlit /streamlit/*
	handle @streamlit {
		header Cache-Control "no-store"
		forward_auth 127.0.0.1:8000 {
			uri /api/v1/auth/streamlit-access
			# The auth subrequest must stay HTTP even when Streamlit upgrades.
			header_up -Upgrade
			header_up -Connection
		}
		reverse_proxy 127.0.0.1:8501
	}

	handle {
		respond "Not Found" 404
	}
}

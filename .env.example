# Local application and API boundary.
# scripts/start.sh also forces USE_LOCAL_API=true when launching
# FastAPI + Streamlit.
#
# Repository defaults are cost-safe: MODEL_PROVIDER=mock and
# AUTO_ADVANCE_STAGES=false (local/tests confirmation mode). Production month-1
# pilot uses AUTO_ADVANCE_STAGES=true via compose.prod.yaml. After month 1,
# switch production to stage-selection (feature TBD) with auto-advance off.
# Automated tests force confirmation mode via tests/conftest.py.

# development keeps mock/sqlite/local defaults. Production Compose sets
# APP_ENV=production so validate_production_configuration fail-closes.
APP_ENV=development

# Safe offline default. Set openai or ollama in a private .env when needed.
MODEL_PROVIDER=mock
USE_LOCAL_API=true
CO_DESIGN_API_URL=http://127.0.0.1:8000
# Browser-facing origins. Production Compose overrides these with the public
# HTTPS domain while keeping CO_DESIGN_API_URL on the container loopback.
CO_DESIGN_PUBLIC_API_URL=http://127.0.0.1:8000
CO_DESIGN_UI_URL=http://127.0.0.1:8501

# Cognito owns the browser session via HttpOnly cookies (refresh + ID token).
# Never put these tokens in localStorage, DB, or API JSON bodies.
# Cookie Max-Age for refresh defaults to 30 days; Cognito app-client refresh
# token validity is authoritative (~30d when configured that way).
COGNITO_REFRESH_COOKIE_NAME=co_design_refresh
COGNITO_ID_TOKEN_COOKIE_NAME=co_design_id
# Non-sensitive Path=/ marker so Streamlit can refresh after the 1h ID cookie.
COGNITO_SESSION_HINT_COOKIE_NAME=co_design_session
COGNITO_REFRESH_COOKIE_MAX_AGE=2592000
COGNITO_ID_TOKEN_COOKIE_MAX_AGE=3600
# false for local HTTP on 127.0.0.1; production Compose sets true for HTTPS.
AUTH_COOKIE_SECURE=false

# Cognito authorization-code callback owned by FastAPI (not Streamlit).
# Precedence: COGNITO_REDIRECT_URI -> secrets.toml redirect_uri ->
# CO_DESIGN_PUBLIC_API_URL + /api/v1/auth/callback.
# Local default matches public API origin; production Compose overrides this.
COGNITO_REDIRECT_URI=http://127.0.0.1:8000/api/v1/auth/callback
# COGNITO_CLIENT_ID=
# COGNITO_CLIENT_SECRET=
# COGNITO_SERVER_METADATA_URL=https://cognito-idp.<aws-region>.amazonaws.com/<user-pool-id>/.well-known/openid-configuration
# Optional: when unset, the app derives /oauth2/revoke from the trusted
# discovery token_endpoint origin because Cognito discovery normally omits it.
# COGNITO_REVOCATION_ENDPOINT=https://<domain>.auth.<region>.amazoncognito.com/oauth2/revoke
# COGNITO_SCOPES=openid email profile

# Thinking Path stage progression (does NOT enable/disable coach recommendations).
# The coach can still return recommendation=advance either way.
#
# false = confirmation mode (repository default):
#   - Coach ADVANCE creates a pending transition; stage does not move yet.
#   - Chat shows a caption that a next step is ready in Thinking Path.
#   - Student presses Next, sees an early-advance warning, then confirms.
#   - Requires USE_LOCAL_API=true so Next can resolve via the API.
#
# Stage progression (operators flip these for month-1 vs month-2):
# AUTO_ADVANCE_STAGES=true  — coach ADVANCE applies immediately; Next UI hidden.
# STUDENT_STAGE_SELECTION=true — Journey shows "Work on this stage" for any stage.
# If both are true, selection wins and auto-advance is treated as off.
# Production month-1 (compose.prod.yaml): AUTO_ADVANCE=true, SELECTION=false.
# Month-2+: STUDENT_STAGE_SELECTION=true and AUTO_ADVANCE_STAGES=false.
AUTO_ADVANCE_STAGES=false
STUDENT_STAGE_SELECTION=false

# Locked coaching model — used when MODEL_PROVIDER=openai.
# DEFAULT_REASONING_EFFORT=low is the cheapest paid reasoning setting.
DEFAULT_CHAT_MODEL=gpt-5.6-luna
DEFAULT_REASONING_EFFORT=low
OPENAI_CHAT_MODEL=gpt-5.6-luna

# Shared local lecture-note folder. Relative paths are resolved from the project.
# Keep MAX_COURSE_MATERIAL_SIZE_MB high enough for large instructor PDFs (~35MB+).
LECTURE_NOTES_DIR=lecture_notes
MAX_LECTURE_NOTES=20
MAX_COURSE_MATERIAL_SIZE_MB=50
# Local demo may copy lecture files into notebook storage. Production compose
# forces false so student-upload S3 is never filled with course PDFs.
COURSE_MATERIAL_SYNC_ENABLED=true

# Optional local Ollama provider (set MODEL_PROVIDER=ollama) — free local inference.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=gpt-oss:20b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Paid OpenAI provider. Never commit a populated key.
# Keep MOCK_OPENAI=true for repository defaults; set false only for live coaching.
OPENAI_API_KEY=
MOCK_OPENAI=true
MOCK_RECOMMEND_ADVANCE=false

# Cost / safety limits — prefer the low end to reduce prompt size and tool loops.
MAX_FILES_PER_MESSAGE=5
MAX_FILE_SIZE_MB=10
MAX_TOOL_ITERATIONS=3
ENABLE_LOCAL_CODE_EXECUTION=false

# In-process coach rate limits (single EC2 app container only; not multi-replica).
# Applied when a new provider execution is claimed for /api/v1/coach/turn and
# /api/v1/coach/turn/stream. Same-key waiters/replays do not consume slots.
# Exceeding limits returns HTTP 429 with Retry-After (NDJSON error on stream).
MAX_ACTIVE_COACH_REQUESTS_PER_USER=1
COACH_REQUESTS_PER_MINUTE=8
MAX_CONCURRENT_MODEL_CALLS=20

# Public Cognito login-start throttle (OAuth-state writes; single EC2 process).
# On limit, /api/v1/auth/login redirects to /?auth_error=1 with Retry-After.
AUTH_LOGIN_REQUESTS_PER_MINUTE_PER_IP=10
AUTH_LOGIN_REQUESTS_PER_MINUTE_GLOBAL=60

# ---------------------------------------------------------------------------
# Storage providers
# Local development / tests (defaults):
#   DATABASE_PROVIDER=sqlite
#   FILE_STORAGE_PROVIDER=local
# Production EC2 (compose.prod.yaml):
#   DATABASE_PROVIDER=dsql
#   FILE_STORAGE_PROVIDER=s3
#   AWS_REGION=us-west-2
#   DSQL_ENDPOINT=<cluster endpoint hostname>
#   USER_UPLOADS_BUCKET=<bucket name>
# Never put permanent DSQL passwords or AWS access keys in this file.
# EC2 should use an instance IAM role for DSQL, S3, ECR, and Bedrock.
# ---------------------------------------------------------------------------
DATABASE_PROVIDER=sqlite
FILE_STORAGE_PROVIDER=local
AWS_REGION=us-west-2
# DSQL_ENDPOINT=
# DSQL_DATABASE=postgres
# Runtime role only — never admin for the application container.
DSQL_USER=co_design_app
# DSQL_ADMIN_USER=admin   # scripts/init_dsql.py only
# USER_UPLOADS_BUCKET=

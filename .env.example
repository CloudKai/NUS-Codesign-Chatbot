# ============================================================
# NUS CO-DESIGN CHATBOT — LOCAL DEVELOPMENT CONFIGURATION
# ============================================================
#
# This file configures the LOCAL Streamlit + FastAPI application.
#
# IMPORTANT:
# When MODEL_PROVIDER=agentcore, the actual LLM runs inside the REMOTE
# AWS AgentCore Runtime.
#
# Therefore there are TWO environments:
#
# 1. THIS .env
#    -> controls local Streamlit/FastAPI, SQLite, local files,
#       AgentCore ARN/qualifier, stage behaviour, retrieval config.
#
# 2. AWS AGENTCORE RUNTIME ENVIRONMENT
#    -> controls the actual model inside AgentCore, e.g. Sonnet 4.6,
#       Guardrail ID/version, model region.
#
# Do NOT commit this file.
# ============================================================



# ============================================================
# APPLICATION ENVIRONMENT
# ============================================================

# Which application safety/config mode to use.
#
# Possible values:
#
# development
#   - local testing
#   - SQLite/local files allowed
#   - HTTP localhost allowed
#   - production security checks are relaxed
#
# production
#   - DSQL + S3 required
#   - HTTPS required
#   - mock provider rejected
#   - Cognito + production configuration validated
#
# CURRENT:
# Local development.
APP_ENV=development



# ============================================================
# LOCAL API CONNECTION
# ============================================================

# true:
#   Streamlit communicates with FastAPI through HTTP.
#
# false:
#   Some development/test paths may use in-process behaviour.
#
# Keep TRUE for the real application architecture.
USE_LOCAL_API=true


# Address of the local FastAPI server.
#
# Local:
#   http://127.0.0.1:8000
#
# Production:
#   normally your HTTPS API/domain route.
CO_DESIGN_API_URL=http://127.0.0.1:8000
CO_DESIGN_PUBLIC_API_URL=http://127.0.0.1:8000

# Production Compose interpolates browser HTTPS origins from PUBLIC_ORIGIN.
# Set this on the EC2 host (CloudFront URL). Local compose.yaml does not use it.
# PUBLIC_ORIGIN=https://<your-cloudfront-domain>

# Local Cognito callback for the FastAPI auth routes. Production Compose
# overrides this from PUBLIC_ORIGIN.
COGNITO_REDIRECT_URI=http://127.0.0.1:8000/api/v1/auth/callback

# HttpOnly refresh + ID cookies. Cognito app-client refresh token validity
# is authoritative (~30 days). Cookie Max-Age is a browser hint only.
COGNITO_REFRESH_COOKIE_NAME=co_design_refresh
COGNITO_ID_TOKEN_COOKIE_NAME=co_design_id
COGNITO_SESSION_HINT_COOKIE_NAME=co_design_session
COGNITO_REFRESH_COOKIE_MAX_AGE=2592000
AUTH_COOKIE_SECURE=false



# ============================================================
# DATABASE
# ============================================================

# Where notebook state, messages, stage progress, assessments, etc. live.
#
# Possible values:
#
# sqlite
#   - LOCAL development
#   - database stored locally
#
# dsql
#   - PRODUCTION
#   - Aurora DSQL
#
# CURRENT:
# Local testing.
DATABASE_PROVIDER=sqlite



# ============================================================
# FILE STORAGE
# ============================================================

# Where uploads/course files are stored.
#
# Possible values:
#
# local
#   - local filesystem
#   - recommended for laptop development
#
# s3
#   - AWS S3
#   - production configuration
#
# memory
#   - tests only
#
# CURRENT:
# Local filesystem.
FILE_STORAGE_PROVIDER=local



# ============================================================
# MODEL PROVIDER
# ============================================================

# Determines HOW FastAPI gets a coach response.
#
# Possible values:
#
# mock
#   - FREE
#   - deterministic fake responses
#   - best for UI/tests
#
# openai
#   - calls OpenAI API directly
#   - requires OPENAI_API_KEY
#
# bedrock
#   - calls a Bedrock foundation model directly
#   - bypasses AgentCore specialist runtime
#
# agentcore
#   - RECOMMENDED production architecture
#   - FastAPI calls AWS AgentCore Runtime
#   - Q&A / Coaching / Review specialists run there
#
# CURRENT:
# Use remote AgentCore.
MODEL_PROVIDER=agentcore


# Used to suppress paid/model calls in some development paths.
#
# true:
#   use mock behaviour where supported
#
# false:
#   allow actual configured provider
#
# Since MODEL_PROVIDER=agentcore, keep FALSE.
MOCK_OPENAI=false



# ============================================================
# AWS REGION
# ============================================================

# Main AWS region for this application.
#
# Current architecture:
# us-west-2
#
# Keep AgentCore, Bedrock KB and Sonnet configuration aligned here
# unless you deliberately introduce multi-region architecture.
AWS_REGION=us-west-2



# ============================================================
# AGENTCORE RUNTIME
# ============================================================

# ARN of the EXISTING AWS AgentCore Runtime.
#
# This is the runtime containing:
#
# - Q&A specialist
# - Coaching specialist
# - Formative Review specialist
# - stage prompts
# - structured-output contracts
#
# Do NOT create a new ARN unnecessarily.
#
# Keep your existing real ARN here.
AGENTCORE_RUNTIME_ARN=arn:aws:bedrock-agentcore:us-west-2:<ACCOUNT_ID>:runtime/NUSCodesignChatbot_chatbot_harnessAgent-6ncEO79sD7


# Which VERSION/QUALIFIER of the AgentCore runtime to invoke.
#
# Possible values:
#
# DEFAULT
#   - whatever runtime version AWS currently exposes as DEFAULT
#   - convenient after a version has been fully tested
#
# 19
#   - explicit version pin when testing a new runtime without moving DEFAULT
#   - same runtime ARN; do not create a second runtime
#
# Production compose.prod.yaml currently uses AGENTCORE_QUALIFIER=DEFAULT
# (liveVersion 19 includes the Strands structured_output_prompt repair).
AGENTCORE_QUALIFIER=DEFAULT


# Maximum time FastAPI waits for one AgentCore response.
#
# 110 seconds leaves some margin below common HTTP/request limits.
# The durable coach idempotency lease is DERIVED from this value (and
# AGENTCORE_MAX_RETRIES plus KNOWLEDGE_BASE_RETRIEVE_TIMEOUT_SECONDS).
# There is no separate COACH_IDEMPOTENCY_LEASE_SECONDS knob. Raising this
# timeout automatically lengthens the lease so a retry cannot reclaim the
# marker while the original Fast Chat turn is still running.
AGENTCORE_TIMEOUT_SECONDS=110


# Number of automatic retries for AgentCore calls.
#
# 0:
#   safest for cost + idempotency
#   boto max_attempts = max_retries + 1, so 0 means one read-timeout window
#
# 1-2:
#   possible later if you intentionally want retry behaviour
#   each extra attempt multiplies the derived notebook lease
#
# Current recommendation:
# keep 0.
AGENTCORE_MAX_RETRIES=0


# Optional AgentCore microVM session affinity (FastAPI-owned).
#
# false (backend fallback when unset):
#   every InvokeAgentRuntime uses a fresh stateless-<uuid> session
#
# true:
#   FastAPI reuses an opaque runtimeSessionId per owner + notebook + role
#   so AWS can keep a warm dedicated microVM. This is COMPUTE AFFINITY
#   ONLY. DSQL remains the transcript. Bounded history is still sent on
#   every turn. AgentCore Memory is not used and is not authoritative.
#
# Fast Chat and Deep Review use separate sessions for the same notebook.
#
# PRECONDITION: the session id is derived from the store owner identifier,
#   which is "cognito:<sub>" in production and therefore unique per user.
#   Do not enable this with a deployment that reuses one owner identifier
#   across real students (for example a shared local-student login), or
#   those students would share one warm compute session.
# This local example enables affinity for one local owner so smoke/testing can
# exercise warm requests. The backend fallback remains false when unset. Keep
# this false when the same owner identifier is shared by multiple real students.
AGENTCORE_SESSION_AFFINITY_ENABLED=true


# Operator-controlled deployment salt for affinity session ids.
#
# After publishing a new AgentCore runtime version you MUST change
# AGENTCORE_SESSION_GENERATION and redeploy FastAPI. Otherwise warm
# sessions can keep serving the code assets that existed when the
# microVM was created.
#
# Do not derive this from notebook data, owner identity, or from
# AGENTCORE_QUALIFIER alone.
AGENTCORE_SESSION_GENERATION=6



# ============================================================
# AGENTCORE MODEL CONFIGURATION
# ============================================================
#
# IMPORTANT:
#
# These values describe the model expected inside AgentCore.
#
# For production they MUST ALSO be configured in the actual AWS
# AgentCore Runtime process environment.
#
# Putting them only here does NOT configure the remote runtime.
#
# The current runtime deliberately fails closed instead of silently
# selecting another model.
# ============================================================


# Which Strands model-provider path AgentCore uses.
#
# Possible values:
#
# bedrock
#   -> Strands BedrockModel
#   -> Claude Haiku 4.5 (current DEFAULT lightweight path)
#   -> Claude Sonnet 4.6 (Deep Review)
#
# bedrock_mantle_responses
#   -> OpenAIResponsesModel via Bedrock Mantle
#   -> GPT-5.6 Luna (historical runtime versions only)
#
# CURRENT:
# Claude Haiku 4.5 via BedrockModel for router / Q&A / coaching /
# incremental Review. Deep Review stays Sonnet 4.6.
AGENTCORE_MODEL_PROVIDER=bedrock


# Exact model used inside AgentCore when no per-role keys are set.
#
# Haiku 4.5 (current DEFAULT lightweight):
#   global.anthropic.claude-haiku-4-5-20251001-v1:0
#
# Sonnet 4.6 (Deep Review):
#   global.anthropic.claude-sonnet-4-6
#
# Luna (historical Mantle runtimes only):
#   openai.gpt-5.6-luna
#
# NOTE:
# Luna requires AGENTCORE_MODEL_PROVIDER=bedrock_mantle_responses,
# NOT "bedrock". Do not pass openai.gpt-5.6-luna into BedrockModel.
# Do not pass Haiku into Mantle. Do not silently swap Haiku and Sonnet.
AGENTCORE_MODEL_ID=global.anthropic.claude-haiku-4-5-20251001-v1:0


# Region used by the model provider inside AgentCore.
AGENTCORE_MODEL_REGION=us-west-2

# Per-role production models. Changing these requires a new AgentCore Runtime
# version on the SAME ARN, not a new runtime resource.
# ROUTER / Q&A / COACHING / INCREMENTAL REVIEW = Claude Haiku 4.5
# DEEP REVIEW = Claude Sonnet 4.6
ROUTER_MODEL_PROVIDER=bedrock
ROUTER_MODEL_ID=global.anthropic.claude-haiku-4-5-20251001-v1:0
QA_MODEL_PROVIDER=bedrock
QA_MODEL_ID=global.anthropic.claude-haiku-4-5-20251001-v1:0
COACHING_MODEL_PROVIDER=bedrock
COACHING_MODEL_ID=global.anthropic.claude-haiku-4-5-20251001-v1:0
REVIEW_INCREMENTAL_MODEL_PROVIDER=bedrock
REVIEW_INCREMENTAL_MODEL_ID=global.anthropic.claude-haiku-4-5-20251001-v1:0
REVIEW_DEEP_MODEL_PROVIDER=bedrock
REVIEW_DEEP_MODEL_ID=global.anthropic.claude-sonnet-4-6
ROUTER_MIN_CONFIDENCE=0.60
# Periodic Deep Review: every N newly executed, successful Coaching turns
# since the previous successfully persisted Deep Review. Turn-based, not
# elapsed wall-clock time. Q&A, explicit Review, Review-tab opens, failed
# turns, and idempotent replays do not count.
DEEP_REVIEW_INTERVAL_TURNS=3
# Compact Deep Review context only when the frozen transcript exceeds this
# estimated token count. Default 20000 keeps ordinary classroom reviews on
# full history. Compacting also requires meaningful absolute and relative
# token savings in application code. Sonnet max input remains 210000; this
# is not the Fast Chat window.
DEEP_REVIEW_CHECKPOINT_TOKEN_THRESHOLD=20000
# Keep the Reflection-stage Deep Review on full frozen history.
DEEP_REVIEW_FORCE_FULL_FINAL=true



# ============================================================
# BEDROCK GUARDRAIL
# ============================================================
#
# These should ALSO exist in the AWS AgentCore runtime environment.
#
# Haiku and Sonnet BedrockModel use these constructor fields directly.
#
# guardrail_latest_message=True is controlled in code so the guardrail
# focuses on the latest untrusted user turn instead of treating the
# entire trusted curriculum/system prompt as a prompt attack.
# ============================================================


# Your existing Bedrock Guardrail ID.
#
# Example:
# GUARDRAIL_ID=abc123xyz
#
# Do not invent one here — copy your actual configured ID.
GUARDRAIL_ID=<YOUR_GUARDRAIL_ID>


# Published Guardrail version.
#
# Production DEFAULT uses the published version 4.
GUARDRAIL_VERSION=4



# ============================================================
# THINKING PATH PROGRESSION
# ============================================================

# Controls whether an AgentCore recommendation=advance is immediately
# persisted as the next stage.
#
# true:
#   AgentCore says ADVANCE
#        ↓
#   FastAPI validates
#        ↓
#   automatically moves student to next stage
#
# false:
#   AgentCore may still recommend ADVANCE,
#   but a pending transition is created instead.
AUTO_ADVANCE_STAGES=true


# Controls whether students can manually choose Thinking Path stages.
#
# false:
#   stage progression follows coach/workflow
#
# true:
#   student can select stages manually
#   this takes precedence over AUTO_ADVANCE_STAGES
#
# IMPORTANT:
#
# AUTO_ADVANCE_STAGES=true
# STUDENT_STAGE_SELECTION=true
#
# means manual selection wins and auto-advance is effectively disabled.
STUDENT_STAGE_SELECTION=false



# ============================================================
# COURSE MATERIAL SYNCHRONISATION
# ============================================================

# true:
#   expose/import the configured course Lecture Notes / Readings
#
# false:
#   disable automatic course-material synchronisation
#
# Keep TRUE for your chatbot.
COURSE_MATERIAL_SYNC_ENABLED=true



# ============================================================
# LOCAL COURSE MATERIALS
# ============================================================
#
# With:
#
# FILE_STORAGE_PROVIDER=local
#
# local lecture files may be extracted and searched locally.
#
# This means KNOWLEDGE_BASE_ID is not required just to run the
# LOCAL file path.
#
# However, this does NOT reproduce the exact production RAG architecture.
# ============================================================



# ============================================================
# BEDROCK KNOWLEDGE BASE
# ============================================================
#
# OPTIONAL for your current local-file setup.
#
# REQUIRED if you want local FastAPI to exercise the REAL production
# course RAG path.
#
# Production:
#
# official course PDFs
#      ↓
# S3
#      ↓
# Bedrock Knowledge Base Retrieve
#      ↓
# validated [S#] excerpts
#      ↓
# AgentCore
# ============================================================


# Uncomment these when testing the real AWS Knowledge Base:
#
# KNOWLEDGE_BASE_ID=<YOUR_KB_ID>
# KNOWLEDGE_BASE_REGION=us-west-2


# required:
#   Selected course_material_id values are sent as equals/in filters.
#   ValidationException or timeout is an evidence gap. No unfiltered retry.
#
# degraded_unfiltered:
#   Explicit operator fallback: one unfiltered Retrieve, then exact S3-key
#   validation. Use only until sidecars are ingested.
#
# disabled:
#   Do not call Retrieve.
#
# KNOWLEDGE_BASE_STRICT_METADATA_FILTER=true still maps to required.
# False no longer skips the MANAGED filter.
# Production startup also requires COURSE_MATERIALS_BUCKET whenever
# KNOWLEDGE_BASE_ID is set (KB on / course-sync off must not skip bucket
# confirmation).
KNOWLEDGE_BASE_METADATA_FILTER_MODE=required

# Dev-only RAG diagnostics. When true, logs query length, selected titles,
# and top scores. Never logs excerpts, credentials, or full source text.
# CO_DESIGN_RAG_DEBUG=false

# Wall-clock and SDK read timeout for one Knowledge Base Retrieve. Optional
# evidence only; timeout becomes an evidence gap. Default 10 (2–30).
# KNOWLEDGE_BASE_RETRIEVE_TIMEOUT_SECONDS=10

# Shared Retrieve worker pool. A future timeout does not cancel boto.
# Excess calls fail closed immediately (capacity_exhausted) instead of
# queueing unbounded ghost Retrieves.
# KNOWLEDGE_BASE_RETRIEVE_EXECUTOR_WORKERS=4

# Production Knowledge Base type from GetKnowledgeBase.
# JUQNP8AZAZ is MANAGED; VECTOR would send the wrong Retrieve configuration.
# KNOWLEDGE_BASE_TYPE=MANAGED



# ============================================================
# PRODUCTION COURSE S3
# ============================================================
#
# NOT required for your current local-files configuration.
#
# Enable these when reproducing production:
#
# FILE_STORAGE_PROVIDER=s3
# COURSE_MATERIALS_BUCKET=<YOUR_COURSE_BUCKET>
# COURSE_MATERIALS_PREFIX=course/
# KNOWLEDGE_BASE_ID=<YOUR_KB_ID>
# KNOWLEDGE_BASE_REGION=us-west-2
#
# Student uploads normally use:
#
# USER_UPLOADS_BUCKET=<YOUR_USER_UPLOAD_BUCKET>
# ============================================================



# ============================================================
# CONVERSATION / CONTEXT BUDGET
# ============================================================

# Maximum advertised model context window used by planning.
MODEL_CONTEXT_LIMIT_TOKENS=272000


# Maximum amount the application tries to send as input.
#
# Leaves room for:
# output + safety margin.
MODEL_MAX_INPUT_TOKENS=210000


# Reserved tokens for model output.
MODEL_OUTPUT_RESERVE_TOKENS=32000


# Additional buffer so the planner does not run right against
# the model context boundary.
MODEL_CONTEXT_SAFETY_MARGIN_TOKENS=30000


# When the full transcript becomes too large for Deep Review:
#
# derived conversation memory
# +
# this many recent verbatim messages
#
# are sent to AgentCore. Normal chat uses FAST_CHAT_* instead.
HISTORY_RECENT_VERBATIM_MESSAGES=12

# Normal one-call Haiku chat (not Deep Review). These are application
# latency budgets, not model context-window limits. Totals include the
# AgentCore system prompt (fast_chat + shared coaching + stage + runtime).
FAST_CHAT_MAX_INPUT_TOKENS=16000
FAST_CHAT_SOFT_INPUT_TOKENS=12000
FAST_CHAT_RECENT_VERBATIM_MESSAGES=6
FAST_CHAT_RECENT_HISTORY_MAX_TOKENS=3000
FAST_CHAT_HISTORY_MESSAGE_MAX_TOKENS=1500
FAST_CHAT_RETRIEVAL_MAX_CHUNKS=4
FAST_CHAT_RETRIEVAL_MAX_CHARS=8000
FAST_CHAT_PROJECT_CONTEXT_CHARS=2000
# Parsed student-source chunk artifacts in process memory. 0 disables.
# Default 32 MiB; max 256 MiB.
STUDENT_SOURCE_CHUNK_CACHE_MAX_BYTES=33554432
# Bedrock prompt cache for the stable fast-chat pedagogical prefix only.
# Default false. Enable in the AgentCore runtime env after verifying the
# pinned Strands 1.52.0 SystemContentBlock cachePoint path and the Haiku
# 4.5 4,096-token minimum. Do not pad prompts to force eligibility.
FAST_CHAT_PROMPT_CACHE_ENABLED=false



# ============================================================
# COACH CONCURRENCY (single FastAPI process)
# ============================================================
#
# These limits are process-local. Do not add extra Uvicorn workers
# to raise capacity; that would create separate in-memory limiters
# and could allow the same notebook to run two overlapping turns.
#
# The durable DSQL/SQLite coach-request lease is the real mutex. It is
# derived in backend/settings.py from AGENTCORE_TIMEOUT_SECONDS,
# AGENTCORE_MAX_RETRIES, and KNOWLEDGE_BASE_RETRIEVE_TIMEOUT_SECONDS
# (default 270s = two Retrieves + two 110s invokes + persist budget +
# margin). If workers are added, duplicate model calls are prevented
# only while that lease is still valid.
#
# MAX_ACTIVE_COACH_REQUESTS_PER_NOTEBOOK=1
#   Prevents overlapping coaching turns within one notebook.
#
# MAX_ACTIVE_COACH_REQUESTS_PER_USER=2
#   Allows a student to work concurrently in up to two different
#   notebooks. A third overlapping notebook is rejected (429/busy).
#
# COACH_REQUESTS_PER_MINUTE=8
#   Protects against rapid repeated submissions by one student.
#
# MAX_CONCURRENT_MODEL_CALLS=120
#   Historical name; currently the maximum number of simultaneously
#   active provider-backed coaching workflows inside one app process.
#   It does not count internal Router/Coaching/Review model invokes
#   inside one workflow. Production Compose sets 120.
#
# SYNC_THREADPOOL_TOKENS=120
#   Production worker-thread capacity for synchronous FastAPI/Starlette
#   work (including the coaching path). Local default is 40 when unset.
#   Production Compose sets 120.
MAX_ACTIVE_COACH_REQUESTS_PER_NOTEBOOK=1
MAX_ACTIVE_COACH_REQUESTS_PER_USER=2
COACH_REQUESTS_PER_MINUTE=8
MAX_CONCURRENT_MODEL_CALLS=120
SYNC_THREADPOOL_TOKENS=120


# ============================================================
# FILE / TOOL LIMITS
# ============================================================

# Number of files accepted in one student upload action.
MAX_FILES_PER_MESSAGE=5


# Maximum size for a student-uploaded file in MB.
MAX_FILE_SIZE_MB=10


# Legacy tool-loop bound.
#
# Current AgentCore specialists use tools=[],
# so this generally does not control AgentCore Coaching.
MAX_TOOL_ITERATIONS=3


# Prevent local Python/code execution from model requests.
#
# Keep FALSE for the student-facing chatbot.
ENABLE_LOCAL_CODE_EXECUTION=false



# ============================================================
# OPENAI DIRECT PROVIDER
# ============================================================
#
# NOT USED while:
#
# MODEL_PROVIDER=agentcore
#
# Keep the API key EMPTY.
#
# Only populate this if you intentionally change:
#
# MODEL_PROVIDER=openai
# ============================================================

OPENAI_API_KEY=


# These are only used by MODEL_PROVIDER=openai.
#
# You can omit/comment them while using AgentCore.
#
# OPENAI_CHAT_MODEL=<OpenAI-model-id>
# DEFAULT_REASONING_EFFORT=low



# ============================================================
# OPTIONAL LUNA / MANTLE — HISTORICAL RUNTIME VERSIONS ONLY
# ============================================================
#
# Do NOT enable these on the current Haiku DEFAULT path.
# Earlier AgentCore versions used Bedrock Mantle + GPT-5.6 Luna
# for the lightweight roles. Keep this as rollback notes only.
#
# AGENTCORE_MODEL_PROVIDER=bedrock_mantle_responses
# AGENTCORE_MODEL_ID=openai.gpt-5.6-luna
# AGENTCORE_MODEL_REGION=us-west-2
# ROUTER_MODEL_PROVIDER=bedrock_mantle_responses
# ROUTER_MODEL_ID=openai.gpt-5.6-luna
#
# Luna remains stateless:
# stateful=False
#
# DSQL/SQLite history remains authoritative.
#
# The Luna provider uses a different guardrail path
# (Bedrock ApplyGuardrail) rather than the Haiku/Sonnet BedrockModel
# constructor guardrail fields.
# ============================================================

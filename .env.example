# Local application and API boundary.
# scripts/start.sh also forces USE_LOCAL_API=true when launching
# FastAPI + Streamlit.
#
# Cost tip: keep MODEL_PROVIDER=mock for free local work.
# Use ollama for free local models, or openai only for approved live tests.

# Safe local default: deterministic mock coach (no API key / $0).
MODEL_PROVIDER=mock
USE_LOCAL_API=true
CO_DESIGN_API_URL=http://127.0.0.1:8000

# Thinking Path stage progression (does NOT enable/disable coach recommendations).
# The coach can still return recommendation=advance either way.
#
# false = confirmation mode (recommended):
#   - Coach ADVANCE creates a pending transition; stage does not move yet.
#   - Chat shows a caption that a next step is ready in Thinking Path.
#   - Student presses Next, sees an early-advance warning, then confirms.
#   - Requires USE_LOCAL_API=true so Next can resolve via the API.
#
# true = auto-advance:
#   - Coach ADVANCE is accepted immediately; stage moves without Next/confirm.
#   - Next confirmation UI is hidden.
AUTO_ADVANCE_STAGES=false

# Locked coaching model — used when MODEL_PROVIDER=openai.
# DEFAULT_REASONING_EFFORT=low is the cheapest paid reasoning setting.
DEFAULT_CHAT_MODEL=gpt-5.6-luna
DEFAULT_REASONING_EFFORT=low
OPENAI_CHAT_MODEL=gpt-5.6-luna

# Shared local lecture-note folder. Relative paths are resolved from the project.
# Keep MAX_COURSE_MATERIAL_SIZE_MB high enough for large instructor PDFs (~35MB+).
LECTURE_NOTES_DIR=lecture_notes
MAX_LECTURE_NOTES=20
MAX_COURSE_MATERIAL_SIZE_MB=50

# Optional local Ollama provider (set MODEL_PROVIDER=ollama) — free local inference.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=gpt-oss:20b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Optional paid OpenAI provider. Never commit a populated key.
# Set MODEL_PROVIDER=openai and MOCK_OPENAI=false only for approved live tests.
OPENAI_API_KEY=
MOCK_OPENAI=false
MOCK_RECOMMEND_ADVANCE=false

# Cost / safety limits — prefer the low end to reduce prompt size and tool loops.
MAX_FILES_PER_MESSAGE=5
MAX_FILE_SIZE_MB=10
MAX_TOOL_ITERATIONS=3
ENABLE_LOCAL_CODE_EXECUTION=false

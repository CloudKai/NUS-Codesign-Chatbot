cde2300chatbot.duckdns.org {
	encode zstd gzip

	# FastAPI-owned Cognito login and application-session logout.
	handle /api/v1/auth/login {
		reverse_proxy app:8000
	}

	handle /api/v1/auth/callback {
		reverse_proxy app:8000
	}

	handle /api/v1/auth/logout {
		reverse_proxy app:8000
	}

	# Deprecated Streamlit-cookie clear path (migration only).
	handle /api/v1/auth/logout/callback {
		reverse_proxy app:8000
	}

	# Lightweight external probe; does not expose notebook or coaching APIs.
	handle /api/v1/health {
		reverse_proxy app:8000
	}

	# Block every other /api/* path at the edge so unauthenticated FastAPI
	# coaching/CRUD routes never receive public traffic. /api/v1/auth/me stays
	# internal (Streamlit -> container loopback). Caddy selects the most
	# specific handle matcher first, so the routes above still win.
	handle /api/* {
		respond "Not Found" 404
	}

	handle {
		reverse_proxy app:8501
	}
}

cde2300chatbot.duckdns.org {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
	}

	# Browser-only Cognito routes. Session probe (/api/v1/auth/me) and every
	# coaching/CRUD path stay on the app-container loopback.
	handle /api/v1/auth/login {
		reverse_proxy app:8000
	}

	handle /api/v1/auth/callback {
		reverse_proxy app:8000
	}

	handle /api/v1/auth/refresh {
		reverse_proxy app:8000
	}

	handle /api/v1/auth/logout {
		reverse_proxy app:8000
	}

	# Deprecated Streamlit-cookie clear path (migration only).
	handle /api/v1/auth/logout/callback {
		reverse_proxy app:8000
	}

	# Lightweight external probe; does not expose notebook or coaching APIs.
	handle /api/v1/health {
		reverse_proxy app:8000
	}

	# Block every other /api/* path at the edge so unauthenticated FastAPI
	# coaching/CRUD routes never receive public traffic. The refresh cookie is
	# Path=/api/v1/auth and is handled only by the public auth routes above.
	# Caddy selects the most specific handle matcher first, so the routes
	# above still win.
	handle /api/* {
		respond "Not Found" 404
	}

	handle {
		reverse_proxy app:8501
	}
}

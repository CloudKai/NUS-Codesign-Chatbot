cde2300chatbot.duckdns.org {
	encode zstd gzip

	# Exact browser logout callback only. Cognito-authenticated Streamlit
	# sessions use owner-scoped in-process services, so other FastAPI routes
	# must not be reachable on the public hostname.
	handle /api/v1/auth/logout/callback {
		reverse_proxy app:8000
	}

	# Lightweight external probe; does not expose notebook or coaching APIs.
	handle /api/v1/health {
		reverse_proxy app:8000
	}

	# Block every other /api/* path at the edge so unauthenticated FastAPI
	# routes never receive public traffic. Caddy selects the most specific
	# handle matcher first, so the routes above still win.
	handle /api/* {
		respond "Not Found" 404
	}

	handle {
		reverse_proxy app:8501
	}
}

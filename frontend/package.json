{
  "name": "codesign-notebook-reader",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build --base=/pilot/",
    "lint": "eslint .",
    "test": "vitest run",
    "test:browser": "playwright test --config playwright.config.mts",
    "measure:bundle": "node scripts/measure-bundle.mjs",

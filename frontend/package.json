    "api:check": "node scripts/check-api.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "5.108.4",
    "@tanstack/react-router": "^1.170.46",
    "@tiptap/extension-link": "^3.35.0",
    "@tiptap/react": "^3.35.0",
    "@tiptap/starter-kit": "^3.35.0",
    "@xyflow/react": "^13.0.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-markdown": "10.1.0"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.99.0",
    "@playwright/test": "1.64.0",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/react": "^16.3.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "eslint": "10.15.0",
    "jsdom": "^27.2.0",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.74.0",
    "vite": "7.3.8",
    "vitest": "5.1.1"
  },

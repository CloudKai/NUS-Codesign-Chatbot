{
  "components": {
    "schemas": {
      "CitationReference": {
        "description": "A stable source citation that can be resolved in the notebook source viewer.",
        "properties": {
          "excerpt": {
            "default": "",
            "title": "Excerpt",
            "type": "string"
          },
          "label": {
            "title": "Label",
            "type": "string"
          },
          "page": {
            "anyOf": [
              {
                "minimum": 1.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Page"
          },
          "source_id": {
            "title": "Source Id",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "source_id",
          "label",
          "title"
        ],
        "title": "CitationReference",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "ReaderBootstrap": {
        "description": "Initial public projections bound to the same authenticated owner.\n\nThese independently read presentation resources are not a transactional\nworkspace snapshot. No transcript, source body or model call is included.",
        "properties": {
          "listing": {
            "$ref": "#/components/schemas/ReaderNotebooks"
          },
          "preferences": {
            "$ref": "#/components/schemas/ReaderPreferences"
          },
          "session": {
            "$ref": "#/components/schemas/ReaderSession"
          }
        },
        "required": [
          "session",
          "listing",
          "preferences"
        ],
        "title": "ReaderBootstrap",
        "type": "object"
      },
      "ReaderChatSummary": {
        "description": "Bounded, owner-scoped preview of an active saved conversation.",
        "properties": {
          "activity_at": {
            "title": "Activity At",
            "type": "string"
          },
          "preview": {
            "title": "Preview",
            "type": "string"
          }
        },
        "required": [
          "preview",
          "activity_at"
        ],
        "title": "ReaderChatSummary",
        "type": "object"
      },
      "ReaderError": {
        "description": "Public read failure; callers use status codes rather than echoing detail.",
        "properties": {
          "detail": {
            "title": "Detail",
            "type": "string"
          }
        },
        "required": [
          "detail"
        ],
        "title": "ReaderError",
        "type": "object"
      },
      "ReaderMessage": {
        "description": "Visible saved message without private assessment or storage metadata.",
        "properties": {
          "citations": {
            "items": {
              "$ref": "#/components/schemas/CitationReference"
            },
            "title": "Citations",
            "type": "array"
          },
          "content": {
            "title": "Content",
            "type": "string"
          },
          "feedback_available": {
            "default": false,
            "title": "Feedback Available",
            "type": "boolean"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "rating": {
            "anyOf": [
              {
                "enum": [
                  "useful",
                  "not_useful"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Rating"
          },
          "role": {
            "enum": [
              "user",
              "assistant"
            ],
            "title": "Role",
            "type": "string"
          },
          "starred": {
            "default": false,
            "title": "Starred",
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "role",
          "content"
        ],
        "title": "ReaderMessage",
        "type": "object"
      },
      "ReaderNotebook": {
        "description": "Public workspace identity and classification for the sidebar.",
        "properties": {
          "id": {
            "title": "Id",
            "type": "string"
          },
          "kind": {
            "default": "notebook",
            "enum": [
              "notebook",
              "chat"
            ],
            "title": "Kind",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "parent_notebook_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Parent Notebook Id"
          },
          "pinned": {
            "default": false,
            "title": "Pinned",
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "name"
        ],
        "title": "ReaderNotebook",
        "type": "object"
      },
      "ReaderNotebooks": {
        "description": "Owner-fenced notebook list for the read-only pilot.",
        "properties": {
          "chat_summaries": {
            "additionalProperties": {
              "$ref": "#/components/schemas/ReaderChatSummary"
            },
            "title": "Chat Summaries",
            "type": "object"
          },
          "notebooks": {
            "items": {
              "$ref": "#/components/schemas/ReaderNotebook"
            },
            "title": "Notebooks",
            "type": "array"
          },
          "owner_id": {
            "title": "Owner Id",
            "type": "string"
          }
        },
        "required": [
          "owner_id",
          "notebooks",
          "chat_summaries"
        ],
        "title": "ReaderNotebooks",
        "type": "object"
      },
      "ReaderPage": {
        "description": "Chronological transcript page fenced to owner, notebook, and revision.",
        "properties": {
          "conversation_revision": {
            "title": "Conversation Revision",
            "type": "integer"
          },
          "messages": {
            "items": {
              "$ref": "#/components/schemas/ReaderMessage"
            },
            "title": "Messages",
            "type": "array"
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Cursor"
          },
          "notebook": {
            "$ref": "#/components/schemas/ReaderNotebook"
          },
          "owner_id": {
            "title": "Owner Id",
            "type": "string"
          },
          "total_count": {
            "title": "Total Count",
            "type": "integer"
          }
        },
        "required": [
          "owner_id",
          "notebook",
          "messages",
          "next_cursor",
          "total_count",
          "conversation_revision"
        ],
        "title": "ReaderPage",
        "type": "object"
      },
      "ReaderPreferences": {
        "description": "Presentation defaults scoped to the verified workspace owner.",
        "properties": {
          "appearance": {
            "enum": [
              "System",
              "Light",
              "Dark"
            ],
            "title": "Appearance",
            "type": "string"
          },
          "default_mode": {
            "enum": [
              "lecture",
              "project"
            ],
            "title": "Default Mode",
            "type": "string"
          },
          "display_name": {
            "title": "Display Name",
            "type": "string"
          },
          "owner_id": {
            "title": "Owner Id",
            "type": "string"
          },
          "reduce_motion": {
            "title": "Reduce Motion",
            "type": "boolean"
          },
          "starter_prompts": {
            "title": "Starter Prompts",
            "type": "boolean"
          }
        },
        "required": [
          "owner_id",
          "appearance",
          "display_name",
          "reduce_motion",
          "default_mode",
          "starter_prompts"
        ],
        "title": "ReaderPreferences",
        "type": "object"
      },
      "ReaderSession": {
        "description": "Nonsecret identity used to fence in-memory browser state.",
        "properties": {
          "display_name": {
            "title": "Display Name",
            "type": "string"
          },
          "kind": {
            "enum": [
              "guest",
              "registered"
            ],
            "title": "Kind",
            "type": "string"
          },
          "owner_id": {
            "title": "Owner Id",
            "type": "string"
          }
        },
        "required": [
          "owner_id",
          "display_name",
          "kind"
        ],
        "title": "ReaderSession",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Co-design browser reader",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/reader/bootstrap": {
      "get": {
        "description": "Load initial projections with one authentication and existing bulk list read.",
        "operationId": "readerBootstrap",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReaderBootstrap"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReaderError"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReaderError"
                }
              }
            },
            "description": "Forbidden"
          }
        },
        "summary": "Bootstrap"
      }
    },
    "/api/v1/reader/session": {
      "get": {
        "description": "Return the verified owner without tokens or private profile fields.",
        "operationId": "readerSession",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReaderSession"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReaderError"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReaderError"
                }
              }
            },
            "description": "Forbidden"
          }
        },
        "summary": "Session"
      }
    },
    "/api/v1/reader/threads": {
      "get": {
        "description": "List owned notebooks without changing or migrating their data.",
        "operationId": "readerNotebooks",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReaderNotebooks"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReaderError"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReaderError"
                }
              }
            },
            "description": "Forbidden"
          }
        },
        "summary": "Notebooks"
      }
    },
    "/api/v1/reader/threads/{thread_id}/messages/page": {
      "get": {
        "description": "Read active saved history using existing revision-bound pagination.",
        "operationId": "readerMessages",
        "parameters": [
          {
            "in": "path",
            "name": "thread_id",
            "required": true,
            "schema": {
              "title": "Thread Id",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 20,
              "maximum": 100,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 2048,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Cursor"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReaderPage"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReaderError"
                }
              }
            },
            "description": "Bad Request"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReaderError"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReaderError"
                }
              }
            },
            "description": "Forbidden"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReaderError"
                }
              }
            },
            "description": "Not Found"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReaderError"
                }
              }
            },
            "description": "Conflict"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Messages"
      }
    }
  }
}

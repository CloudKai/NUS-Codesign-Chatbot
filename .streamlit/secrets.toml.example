# Private Cognito app-client settings used by FastAPI login.
# Copy to secrets.toml locally. Do not commit secrets.toml.
# Prefer environment variables in production; this file remains a local source.
# Keep 127.0.0.1 consistent; mixing it with localhost breaks host-scoped cookies.
#
# Cognito tokens establish identity. Ongoing authentication uses Cognito
# refresh + ID-token HttpOnly cookies (never localStorage / DB / API JSON).
# The application does not persist Cognito access, ID, or refresh tokens.

[auth]
# Must match Cognito Allowed callback URLs exactly.
# Precedence when unset in env: this value, else CO_DESIGN_PUBLIC_API_URL + path.
redirect_uri = "http://127.0.0.1:8000/api/v1/auth/callback"
client_id = "<cognito-app-client-id>"
client_secret = "<cognito-app-client-secret>"
server_metadata_url = "https://cognito-idp.<aws-region>.amazonaws.com/<user-pool-id>/.well-known/openid-configuration"
# Cognito must allow these OpenID Connect scopes on the app client.
client_kwargs = { scope = "openid email profile", prompt = "login" }

# Optional legacy Streamlit cookie_secret — unused by FastAPI session auth.
# cookie_secret = "replace-with-persistent-strong-random-secret"

# Production example:
# redirect_uri = "https://<production-domain>/api/v1/auth/callback"
#
# Public Caddy should expose only:
#   /api/v1/auth/login
#   /api/v1/auth/callback
#   /api/v1/auth/me
#   /api/v1/auth/logout
#   /api/v1/health

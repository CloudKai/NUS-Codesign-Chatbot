# Copy to secrets.toml for local Streamlit OIDC (Amazon Cognito).
# Do not commit secrets.toml. Load production client_secret and cookie_secret
# from AWS Secrets Manager or the deployment secret injector; keep cookie_secret
# stable across process restarts.
# Keep 127.0.0.1 consistent; mixing it with localhost breaks host-scoped cookies.

[auth]
redirect_uri = "http://127.0.0.1:8501/oauth2callback"
cookie_secret = "replace-with-persistent-strong-random-secret"
client_id = "<cognito-app-client-id>"
client_secret = "<cognito-app-client-secret>"
server_metadata_url = "https://cognito-idp.<aws-region>.amazonaws.com/<user-pool-id>/.well-known/openid-configuration"
# Cognito must allow these OpenID Connect scopes on the app client.
# Use prompt=login (Streamlit's default select_account is not valid for Cognito).
client_kwargs = { scope = "openid email profile", prompt = "login" }

# Optional Cognito hosted /logout. Profile Logout does not use this by default;
# it clears Streamlit cookies via the local API callback and returns to the
# login gate. Only enable Cognito /logout after this exact logout_uri is listed
# under Cognito Allowed sign-out URLs.
# cognito_domain = "https://<your-domain>.auth.<aws-region>.amazoncognito.com"
# logout_uri = "http://127.0.0.1:8000/api/v1/auth/logout/callback"

# Production example (do not use CloudFront for the initial architecture):
# redirect_uri = "https://<production-domain>/oauth2callback"
# Route /api/v1/auth/logout/callback to FastAPI on this same cookie host.
# logout_uri = "https://<production-domain>/api/v1/auth/logout/callback"
#
# Streamlit 1.60 stores signed identity and token cookies for 30 days. It does
# not expose or retain Cognito refresh tokens, so Cognito refresh-token rotation
# settings do not control this application cookie lifetime.
